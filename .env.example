# Salin file ini jadi ".env" lalu isi dengan nilai dari Firebase Console-mu.
# Lihat README.md bagian "Setup Firebase" untuk cara mendapatkannya.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opsional — biarkan kosong kalau cuma dipakai 1 toko/tim
VITE_WORKSPACE_ID=default
